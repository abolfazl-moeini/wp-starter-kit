parameters:
    level: 5
    phpVersion: 80100
    treatPhpDocTypesAsCertain: false
    paths:
        - .
    excludePaths:
        - vendor/*
        - dev/*
        - assets/*
        - node_modules/*
        - dist/*
        # Vendored third-party framework — analysed upstream, not in kit CI.
        - packages/wpdev-framework/*
        # Test harness that requires WordPress stubs — analysed in consumer CI.
        - packages/plugin-core-test/*
        - tests/*
        - wp-content/*
        - packages/*/vendor/*
        - core/packages/*/vendor/*
        - packages/mcp-integration/tests/*
        - packages/php-fault-tolerance/tests/*
        - packages/php-fault-tolerance/src/Stub/*
        # Standalone-build obfuscator internals tracked separately in FIX_PLAN_PIPELINE.md
        - packages/standalone-build/*
