# Copy to .env and set absolute paths for your machine.
#   cp env.example .env
# Then edit PLUGIN_ROOT, WORDPRESS_DEVELOP_ROOT, DOCKER_PHPUNIT_DIR.

# --- Required: host paths (absolute) ---
PLUGIN_ROOT=/absolute/path/to/{{slug}}
WORDPRESS_DEVELOP_ROOT=/absolute/path/to/wordpress-develop
DOCKER_PHPUNIT_DIR=/absolute/path/to/{{slug}}/tests/docker-phpunit

# --- Container paths (defaults match docker-compose.yml) ---
PLUGIN_CONTAINER_PATH=/var/www/plugin
WORDPRESS_DEVELOP_CONTAINER_PATH=/var/www/wordpress-develop
DOCKER_PHPUNIT_CONTAINER_PATH=/var/www/docker-phpunit
WP_TESTS_LIB_CONTAINER_PATH=/var/www/wordpress-tests-lib
WORDPRESS_CORE_CONTAINER_PATH=/var/www/wordpress-develop/src

# Service names in docker-compose.yml
PHP_SERVICE=php
DB_SERVICE=db

# --- Docker images ---
# Default matches wpdev.json phpMinVersion at scaffold / set time.
PHP_IMAGE={{phpImage}}
MYSQL_IMAGE=mysql:8.0

# Optional on Apple Silicon if an image lacks arm64:
# DOCKER_DEFAULT_PLATFORM=linux/amd64

# --- Database (dedicated test database only — never production) ---
DB_NAME=wp_tests
DB_USER=wp_test_user
DB_PASSWORD=wp_test_pass
DB_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3308

# --- PHPUnit (relative to PLUGIN_CONTAINER_PATH unless absolute) ---
PHPUNIT_BIN=./vendor/bin/phpunit
