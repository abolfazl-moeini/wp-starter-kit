    "user_guide_dir": "docs/user-guide",
    "output_dir": "dist/docs",
    "formats": ["pdf", "docx"],
    "template": "purple_book",
    "direction": "rtl"
  },
  "build": {
    "assetMappings": [],
    "globalMappings": {},
    "styleEntryPoints": ["assets/stylesheets/style.css"]
